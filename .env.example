# Precept API Credentials
PRECEPT_API_KEY=your_api_key_here

# MCP Transport Configuration
# Options: stdio, http
MCP_TRANSPORT=stdio

# HTTP Mode Configuration (only used if MCP_TRANSPORT=http)
PORT=3000
# Comma-separated list of allowed hosts for DNS rebinding protection (e.g. localhost,my-mcp.domain.com)
ALLOWED_HOSTS=localhost
