# ──────────────────────────────────────────
# Precept API Credentials
# ──────────────────────────────────────────
# Used in stdio mode or as a fallback when OAuth is disabled.
PRECEPT_API_KEY=your_api_key_here

# ──────────────────────────────────────────
# MCP Transport Configuration
# ──────────────────────────────────────────
# Options: stdio (default), http
MCP_TRANSPORT=stdio

# ──────────────────────────────────────────
# HTTP Mode Configuration
# (All below are only used when MCP_TRANSPORT=http)
# ──────────────────────────────────────────
PORT=3000

# DNS rebinding protection: comma-separated list of allowed Host header values.
# Include your Railway domain here (e.g. my-app.up.railway.app)
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────
# OAuth 2.1 Configuration
# ──────────────────────────────────────────
# REQUIRED: A strong random secret for signing JWTs and encrypting API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: Redis URL for persistent token storage.
# Without Redis, authorization codes are stored in-memory and lost on restart.
# Railway Redis example: redis://default:password@host:port
REDIS_URL=

# Optional: Comma-separated list of allowed redirect_uri domains.
# Defaults to: claude.ai,chatgpt.com,localhost,127.0.0.1
ALLOWED_REDIRECT_DOMAINS=claude.ai,chatgpt.com,localhost,127.0.0.1

# Optional: Override the upstream Precept API URL.
PRECEPT_API_URL=https://api.preceptai.co.uk

# ──────────────────────────────────────────
# Development Only
# ──────────────────────────────────────────
# Set to "true" to disable OAuth entirely (uses PRECEPT_API_KEY for all requests).
# WILL REFUSE TO START if NODE_ENV=production.
# NO_SECURITY=true
